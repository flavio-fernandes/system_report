# Environment file for the systemd unit. Copy, fill in, and lock it down:
#
#   cp data/system_report.env.example data/system_report.env
#   chmod 600 data/system_report.env
#
# systemd reads this as root before dropping privileges, so the file never has
# to be readable by the service user. Everything under data/ is gitignored.
#
# The variable name must match mqtt.password_env in config.yaml.

SYSTEM_REPORT_MQTT_PASSWORD=
